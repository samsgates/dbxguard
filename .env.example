DBXGUARD_ENV=development
DBXGUARD_DATABASE_URL=sqlite:///./dbxguard.db
DBXGUARD_REDIS_URL=redis://localhost:6379/0
DBXGUARD_SECRET_KEY=change-me
DBXGUARD_LOG_LEVEL=INFO
DBXGUARD_FAIL_CLOSED=true
DBXGUARD_CORS_ORIGINS=http://localhost:3000

# Databricks standard auth variables are supported by databricks-sdk.
# DATABRICKS_HOST=https://<workspace-host>
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# DATABRICKS_TOKEN=
