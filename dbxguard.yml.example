version: 1
analysis:
  lineage:
    enabled: true
    max_depth: 15
  cost: {enabled: true}
  security: {enabled: true}
  ml: {enabled: true}
risk:
  thresholds:
    warning: 40
    approval: 60
    block: 80
criticality:
  tier0:
    - finance.*
    - payments.*
policies:
  packs:
    - dbxguard/default
    - dbxguard/production
ci:
  failure_mode: closed
